{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@rentevent/api",
        "dev"
      ],
      "port": 4000,
      "env": {
        "DATABASE_URL": "postgresql://postgres@localhost:55432/rentevent",
        "ALLOWED_ORIGINS": "http://localhost:3002,http://localhost:3003",
        "ADMIN_SESSION_SECRET": "local-dev-secret",
        "NODE_ENV": "development",
        "ENABLE_TEST_AUTH": "true",
        "TEST_PHONE_NUMBERS": "998901112233",
        "TEST_OTP_CODE": "111111"
      }
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@rentevent/web",
        "exec",
        "next",
        "dev",
        "--port",
        "3002"
      ],
      "port": 3002,
      "env": {
        "NEXT_PUBLIC_API_URL": "http://localhost:4000/api"
      }
    },
    {
      "name": "admin",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@rentevent/admin",
        "exec",
        "next",
        "dev",
        "--port",
        "3003"
      ],
      "port": 3003,
      "env": {
        "NEXT_PUBLIC_API_URL": "http://localhost:4000/api"
      }
    }
  ]
}