# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rentevent"

# Admin
ADMIN_API_KEY="your-admin-api-key"

# Auth
# Test auth = App Review account: customer login only, no SMS is sent, a fixed code logs in.
# TEST_PHONE_NUMBERS: comma separated, format 998XXXXXXXXX (no +). Never a staff phone.
# TEST_OTP_CODE: exactly 6 digits. Production (ENABLE_TEST_AUTH=true) refuses to boot with
# more than 2 phones, a malformed phone or code, or a staff phone in the list.
# Real values live only in Railway, never in the repo. See docs/ops/app-review-account.md.
ENABLE_TEST_AUTH="false"
TEST_PHONE_NUMBERS=""
TEST_OTP_CODE=""

# SMS provider: exactly "gateway" (production; the API refuses to boot with anything
# else) or "mock" (local dev/test only, needs NODE_ENV=development or test; prints the code).
# A typo such as "Gateway" is a boot error. The direct "eskiz" provider was removed.
SMS_PROVIDER="mock"
# Gateway base URL including /api/v1, no trailing slash; key of the "rentevent" project.
SMS_GATEWAY_URL=""
SMS_GATEWAY_API_KEY=""
# Global ceiling of SMS per rolling 24 h (customer + admin reset); `sms_daily` log line at 50/70/90/100 %.
SMS_DAILY_CAP="1000"

# OTP codes are stored as HMAC-SHA256(code, OTP_PEPPER). REQUIRED in production (the API refuses
# to boot without it); optional in development/test (fixed dev default). Generate a value with
# `openssl rand -hex 32` and set it only in Railway. Changing it invalidates codes in flight (5 min).
OTP_PEPPER=""

# Upload
UPLOADTHING_TOKEN=""

# CORS (production)
ALLOWED_ORIGINS="https://rentevent.uz,https://www.rentevent.uz,https://admin.rentevent.uz"

# Yandex Maps (for admin)
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=""

# API URL (for web/admin frontends)
# Local dev:
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
# Production:
# NEXT_PUBLIC_API_URL="https://api.rentevent.uz/api"
